# Host port exposed by Docker Compose.
TWINKLE_PORT=3002

# Runtime queue settings.
NOVA_TASK_CONCURRENCY=10
NOVA_MAX_QUEUE_SIZE=200
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_IP=20
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_API_KEY=20

# Prompt gallery: 1=public, 2=password protected, 3=disabled.
PROMPT_GALLERY_MODE=2
PROMPT_GALLERY_PASSWORD=change-this-password
